// Prisma schema for the memorial site of شهید ابوالفضل دهنوی
// Full page-builder CMS: Pages → Sections (typed, configurable) + Media library + Blog

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Global site settings (single row, id="main")
model SiteSetting {
  id              String   @id @default("main")
  fullName        String   @default("ابوالفضل دهنوی")
  displayTitle    String   @default("شهید ابوالفضل دهنوی")
  subtitle        String   @default("امدادگر یکم جمعیت هلال احمر")
  birthDate       String?
  martyrdomDate   String   @default("۱۵ فروردین ۱۴۰۵")
  martyrdomPlace   String   @default("شهرستان مبارکه، اصفهان")
  role            String   @default("امدادگر یکم جمعیت هلال احمر")
  heroImage       String?
  heroIntro       String?
  publicUrl       String?
  adminPassword   String   @default("abolfazl1405")
  /// Global body font key
  globalFontKey   String   @default("vazirmatn")
  /// Global heading/display font key
  headingFontKey  String   @default("nastaliq")
  /// Theme accent: emerald | royal | crimson | gold
  accent          String   @default("emerald")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// A page of the site (Home, Biography, Gallery, Timeline, Memories, Blog, ...)
model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String?
  showInNav   Boolean  @default(true)
  navIcon     String   @default("FileText")
  isHome      Boolean  @default(false)
  order       Int      @default(0)
  sections    Section[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// A typed, configurable section belonging to a page.
/// `config` holds a JSON string with type-specific settings.
model Section {
  id          String   @id @default(cuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type        String   // hero | text | image | gallery | slider | video | timeline | quotes | guestbook | blogList | divider | cta
  title       String?
  subtitle    String?
  config      String   @default("{}") // JSON
  fontKey     String?  // optional per-section font override
  background  String   @default("default") // default | parchment | emerald | gold
  order       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Media library — every uploaded file gets a record (editable metadata).
model MediaFile {
  id          String   @id @default(cuid())
  url         String   @unique
  type        String   @default("image") // image | video
  thumb       String?
  title       String?
  description String?
  alt         String?
  category    String   @default("عمومی") // folder/category name
  width       Int?
  height      Int?
  size        Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Custom uploaded fonts (TTF/OTF) — injected as @font-face at runtime.
model FontFile {
  id        String   @id @default(cuid())
  name      String   @unique // font-family identifier, e.g. "MyNastaliq"
  label     String   // display label, e.g. "نستعلیق اختصاصی"
  url       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Blog/news posts (memorial events, charity acts in his name, tributes, ...)
model BlogPost {
  id          String   @id @default(cuid())
  title       String
  excerpt     String?
  content     String
  coverImage  String?
  videoUrl    String?
  publishedAt String?
  featured    Boolean  @default(false)
  tags        String?  // comma separated
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Guestbook messages left by visitors
model GuestMessage {
  id        String   @id @default(cuid())
  name      String
  text      String
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
}
